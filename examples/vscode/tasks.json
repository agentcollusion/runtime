{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentCollusion: run a text job with your agents",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@agentcollusion/runtime/bin/agentcollusion.mjs",
        "run",
        "--file",
        "${input:jobPath}",
        "--writer",
        "${input:writerProvider}",
        "--reviewer",
        "${input:reviewerProvider}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentCollusion: run the local handoff demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@agentcollusion/runtime/bin/agentcollusion.mjs",
        "demo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentCollusion: run the local guardrail harness",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@agentcollusion/runtime/bin/agentcollusion.mjs",
        "harness"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentCollusion: start a private local host",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@agentcollusion/runtime/bin/agentcollusion.mjs",
        "serve",
        "--dir",
        "${workspaceFolder}/.agentcollusion"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentCollusion: verify an evidence file",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@agentcollusion/runtime/bin/agentcollusion.mjs",
        "verify",
        "${input:evidencePath}",
        "--fingerprint",
        "${input:trustedFingerprint}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentCollusion: inspect a signed audit",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@agentcollusion/runtime/bin/agentcollusion.mjs",
        "trace",
        "${input:auditPath}",
        "--fingerprint",
        "${input:trustedFingerprint}",
        "--limit",
        "100"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "evidencePath",
      "type": "promptString",
      "description": "Path to a receipt.json or audit.json file"
    },
    {
      "id": "auditPath",
      "type": "promptString",
      "description": "Path to a signed audit JSON file"
    },
    {
      "id": "trustedFingerprint",
      "type": "promptString",
      "description": "Independently trusted SHA-256 key fingerprint (64 lowercase hex characters)"
    },
    {
      "id": "jobPath",
      "type": "promptString",
      "description": "Path to your text job JSON file"
    },
    {
      "id": "writerProvider",
      "type": "pickString",
      "description": "Authenticated CLI for the writer; model usage applies",
      "options": [
        "codex",
        "claude"
      ],
      "default": "codex"
    },
    {
      "id": "reviewerProvider",
      "type": "pickString",
      "description": "Authenticated CLI for the independent reviewer; model usage applies",
      "options": [
        "codex",
        "claude"
      ],
      "default": "codex"
    }
  ]
}
