{
  "name": "@agentcollusion/runtime",
  "version": "0.1.0-beta.2",
  "description": "Connect independent agents with scoped tasks, durable handoffs and verifiable receipts.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agentcollusion": "./bin/agentcollusion.mjs"
  },
  "types": "./types/client.d.mts",
  "exports": {
    ".": {
      "types": "./types/client.d.mts",
      "default": "./src/client.mjs"
    },
    "./server": {
      "types": "./types/server.d.mts",
      "default": "./src/server.mjs"
    },
    "./evidence": {
      "types": "./types/evidence.d.mts",
      "default": "./src/evidence.mjs"
    },
    "./worker": {
      "types": "./types/worker.d.mts",
      "default": "./src/worker.mjs"
    }
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "examples/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:types": "tsc --noEmit -p test/types/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "package:release": "node scripts/package-release.mjs",
    "demo": "node examples/demo.mjs"
  },
  "homepage": "https://agentcollusion.ai/service/runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentcollusion/runtime.git"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "developer-tools",
    "audit",
    "permissions"
  ],
  "dependencies": {
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
